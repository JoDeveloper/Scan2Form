{
  "name": "scan2form",
  "version": "1.5.0",
  "description": "Local offline bridge allowing web browsers to access physical scanners (WIA, TWAIN, SANE).",
  "main": "dist/scanner-client.js",
  "scripts": {
    "start": "node dist/bridge-server.js",
    "example": "npm run build && npm start",
    "dev": "nodemon --exec ts-node src/bridge-server.ts",
    "build": "tsc && tsc src/scanner-client.ts --target es2020 --module es2020 --moduleResolution node --outDir dist/esm",
    "test": "jest",
    "prepublishOnly": "npm run build"
  },
  "bin": {
    "scan2form-server": "dist/bridge-server.js"
  },
  "types": "./dist/scanner-client.d.ts",
  "files": [
    "dist",
    "example",
    "README.md",
    "LICENSE",
    "start-server.bat",
    "start-server.sh"
  ],
  "keywords": [
    "scanner",
    "twain",
    "wia",
    "sane",
    "web-scanning",
    "local-bridge"
  ],
  "author": "jodeveloper8",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoDeveloper/Scan2Form.git"
  },
  "bugs": {
    "url": "https://github.com/JoDeveloper/Scan2Form/issues"
  },
  "homepage": "https://github.com/JoDeveloper/Scan2Form#readme",
  "engines": {
    "node": ">=16"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.6",
    "@types/supertest": "^6.0.3",
    "jest": "^30.2.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
